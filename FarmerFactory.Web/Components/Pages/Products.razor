@page "/products"
@using FarmerFactory.Web.Services
@using System.ComponentModel.DataAnnotations
@inject IClientService ClientService
@inject IProductService ProductService
@inject IPurchaseService PurchaseService
@rendermode InteractiveServer

<PageTitle>Products</PageTitle>

<div class="container mt-4">
    <h1>Products</h1>

    <div class="row mb-4">
        <div class="col-md-4">
            <label for="clientSelect" class="form-label">Select Client</label>
            <select class="form-select" id="clientSelect" value="@selectedClientId.ToString()" @onchange="HandleClientChange">
                <option value="0">-- Choose a Client --</option>
                @foreach (var client in clients)
                {
                    <option value="@client.Id">@client.Name</option>
                }
            </select>
        </div>
    </div>

    @if (isLoadingProducts)
    {
        <div class="alert alert-info">Loading products...</div>
    }
    else if (products.Count == 0)
    {
        <div class="alert alert-warning">No products available.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Type</th>
                        <th>Qty</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in products)
                    {
                        <tr>
                            <td>@product.Id</td>
                            <td>@product.Name</td>
                            <td>@product.Description</td>
                            <td>$@product.Price.ToString("F2")</td>
                            <td>@product.Stock</td>
                            <td>@product.ProductType</td>
                            <td>
                                <input type="number" class="form-control form-control-sm @(GetQuantityInputClass(product.Id))" 
                                       min="1" max="@product.Stock" value="@GetProductQuantity(product.Id)"
                                       @onchange="@((ChangeEventArgs e) => SetProductQuantity(product.Id, e))"
                                       style="width: 80px;" />
                            </td>
                            <td>
                                <button class="btn btn-primary btn-sm"
                                        @onclick="() => PurchaseProduct(product.Id)"
                                        disabled="@(selectedClientId == 0)">
                                    Purchase
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
        </div>
    }
</div>

@code {
    private List<ClientResponse> clients = new();
    private List<ProductResponse> products = new();
    private Dictionary<int, int> productQuantities = new();
    private Dictionary<int, string> quantityErrors = new();
    private int selectedClientId = 0;
    private bool isLoadingProducts = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadClientsAsync();
        await LoadProductsAsync();
    }

    private Task HandleClientChange(ChangeEventArgs e)
    {
        if (e?.Value != null)
        {
            var value = e.Value.ToString() ?? "0";
            if (int.TryParse(value, out var clientId))
            {
                selectedClientId = clientId;
            }
        }
        return Task.CompletedTask;
    }

    private int GetProductQuantity(int productId)
    {
        return productQuantities.ContainsKey(productId) ? productQuantities[productId] : 1;
    }

    private void SetProductQuantity(int productId, ChangeEventArgs e)
    {
        quantityErrors.Remove(productId);

        if (e?.Value == null || string.IsNullOrWhiteSpace(e.Value.ToString()))
        {
            quantityErrors[productId] = "Quantity is required. Please enter a value.";
            productQuantities[productId] = 1;
            return;
        }

        if (int.TryParse(e.Value.ToString(), out int qty))
        {
            if (qty <= 0)
            {
                quantityErrors[productId] = "Quantity must be greater than 0.";
                productQuantities[productId] = 1;
            }
            else
            {
                var product = products.FirstOrDefault(p => p.Id == productId);
                if (product != null && qty > product.Stock)
                {
                    quantityErrors[productId] = $"Quantity cannot exceed available stock ({product.Stock}).";
                    productQuantities[productId] = product.Stock;
                }
                else
                {
                    productQuantities[productId] = qty;
                }
            }
        }
        else
        {
            quantityErrors[productId] = "Please enter a valid number.";
            productQuantities[productId] = 1;
        }
    }

    private string GetQuantityError(int productId)
    {
        return quantityErrors.ContainsKey(productId) ? quantityErrors[productId] : string.Empty;
    }

    private string GetQuantityInputClass(int productId)
    {
        return quantityErrors.ContainsKey(productId) && !string.IsNullOrEmpty(quantityErrors[productId]) 
            ? "is-invalid" 
            : string.Empty;
    }

    private async Task LoadClientsAsync()
    {
        try
        {
            clients = await ClientService.GetClientsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load clients: {ex.Message}";
        }
    }

    private async Task LoadProductsAsync()
    {
        try
        {
            isLoadingProducts = true;
            products = await ProductService.GetProductsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load products: {ex.Message}";
        }
        finally
        {
            isLoadingProducts = false;
        }
    }

    private async Task PurchaseProduct(int productId)
    {
        if (selectedClientId == 0)
        {
            errorMessage = "Please select a client first.";
            return;
        }

        // Check if there's a validation error for this product
        if (quantityErrors.ContainsKey(productId) && !string.IsNullOrEmpty(quantityErrors[productId]))
        {
            errorMessage = quantityErrors[productId];
            return;
        }

        int quantity = GetProductQuantity(productId);

        if (quantity <= 0)
        {
            errorMessage = "Please enter a valid quantity (greater than 0) before purchasing.";
            return;
        }

        var product = products.FirstOrDefault(p => p.Id == productId);
        if (product != null && quantity > product.Stock)
        {
            errorMessage = $"Quantity cannot exceed available stock ({product.Stock}).";
            return;
        }

        var request = new PurchaseRequest
        {
            ClientId = selectedClientId,
            ProductId = productId,
            Qty = quantity
        };

        var (success, error, data) = await PurchaseService.CreatePurchaseAsync(request);

        if (success)
        {
            successMessage = $"Purchase successful!";
            errorMessage = string.Empty;
            productQuantities[productId] = 1;
            quantityErrors.Remove(productId);
        }
        else
        {
            errorMessage = error ?? "An unexpected error occurred.";
            successMessage = string.Empty;
        }
    }
}