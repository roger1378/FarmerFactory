@page "/purchases"
@using FarmerFactory.Web.Services
@inject IPurchaseService PurchaseService
@rendermode InteractiveServer

<PageTitle>Purchases</PageTitle>

<div class="container mt-4">
    <h1>Purchases</h1>

    @if (isLoading)
    {
        <div class="alert alert-info">Loading purchases...</div>
    }
    else if (purchases.Count == 0)
    {
        <div class="alert alert-warning">No purchases found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Client</th>
                        <th>Product</th>
                        <th>Quantity</th>
                        <th>Purchase Time</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var purchase in purchases)
                    {
                        <tr>
                            <td>@purchase.Id</td>
                            <td>@purchase.ClientName</td>
                            <td>@purchase.ProductName</td>
                            <td>@purchase.Qty</td>
                            <td>@purchase.PurchaseDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            <button class="btn btn-primary" @onclick="RefreshPurchases">
                <span class="bi bi-arrow-clockwise"></span> Refresh
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" style="margin-top: 20px;">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }
</div>

@code {
    private List<PurchaseResponse> purchases = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadPurchasesAsync();
    }

    private async Task LoadPurchasesAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            purchases = await PurchaseService.GetPurchasesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load purchases: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshPurchases()
    {
        await LoadPurchasesAsync();
    }
}
